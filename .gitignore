# Default-deny: this repository publishes only the brain_agent source files.
*

# Keep repository metadata and public documentation.
!/.gitignore
!/README.md

# Publish the root-level Python package files.
!/__init__.py
!/__main__.py
!/adapters.py
!/cli.py
!/controller.py
!/credentials.py
!/decision.py
!/diagnostics.py
!/forum.py
!/knowledge.py
!/memory.py
!/models.py
!/prompting.py
!/reporting.py
!/repository.py
!/runtime.py
!/scoring.py
!/selection.py
!/task_runner.py
!/utils.py

# Local/private material stays out of GitHub.
.env
.env.*
*.pem
*.key
*.py[cod]
__pycache__/
*secret*
*credential*
*password*
*token*
*api_key*
*apikey*
*config.local*
docs/
documents/
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.csv
